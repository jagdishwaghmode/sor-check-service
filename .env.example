# Copy to .env. Never commit real values.
ENV=dev
# SQLite for local dev. Point at the client's Postgres in real environments.
DATABASE_URL=sqlite:///./sor_audit.db
# Fernet key for audit payload encryption. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUDIT_ENC_KEY=
# If set, callers must send X-API-Key.
API_KEY=
# Dev-only failure injection (UI chaos buttons). Keep false outside dev.
ENABLE_CHAOS=true
# Iowa: mock (synthetic, default) or live (real iowasexoffender.gov API, 50 requests/hour limit)
IOWA_MODE=mock
# Comma list of sources that call the real registry, e.g. iowa_direct,dc_open_data,tx_csv. Turns on real-data-only mode.
LIVE_PROVIDERS=
VENDOR_API_KEY=
